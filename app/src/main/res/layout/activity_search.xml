<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SearchActivity">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F4DFCA">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Заголовок -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Исследуй миры"
                    android:gravity="center"
                    android:textColor="#211812"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <!-- Поисковая строка -->
                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:background="#FFF5E9"
                    android:hint="Найти игру, гайд или коллекцию..."
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="#211812"
                    android:textColorHint="#968577"
                    android:textSize="14sp"
                    android:inputType="text" />


                <!-- Коллекции -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Коллекции"
                        android:textColor="#211812"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="serif" />

                    <TextView
                        android:id="@+id/allCollectionsButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Все  →"
                        android:textColor="#B84F13"
                        android:textStyle="bold"
                        android:padding="6dp" />
                </LinearLayout>

                <!-- Три основные коллекции -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- Наследие Souls -->
                    <LinearLayout
                        android:id="@+id/collectionSouls"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="125dp"
                            android:src="@drawable/elden_ring"
                            android:scaleType="centerCrop"
                            android:contentDescription="Наследие Souls" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Наследие Souls"
                            android:textColor="#211812"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Стальные титаны -->
                    <LinearLayout
                        android:id="@+id/collectionWorlds"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="125dp"
                            android:src="@drawable/armored_core3"
                            android:scaleType="centerCrop"
                            android:contentDescription="Стальные титаны" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Стальные титаны"
                            android:textColor="#211812"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Тени ниндзя -->
                    <LinearLayout
                        android:id="@+id/collectionJapan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="125dp"
                            android:src="@drawable/tenchu_fatal_shadows"
                            android:scaleType="centerCrop"
                            android:contentDescription="Тени ниндзя" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Тени ниндзя"
                            android:textColor="#211812"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>


                <!-- Гайды -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Гайды"
                        android:textColor="#211812"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="serif" />

                    <TextView
                        android:id="@+id/allGuidesButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Все  →"
                        android:textColor="#B84F13"
                        android:textStyle="bold"
                        android:padding="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/guideBosses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="#FFF5E9">

                    <ImageView
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:src="@drawable/elden_ring"
                        android:scaleType="centerCrop"
                        android:contentDescription="Гайд по Elden Ring" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ELDEN RING"
                            android:textColor="#B84F13"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Все боссы Междуземья"
                            android:textColor="#211812"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#9B8775"
                        android:textSize="26sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/guideBeginners"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="#FFF5E9">

                    <ImageView
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:src="@drawable/bloodborne"
                        android:scaleType="centerCrop"
                        android:contentDescription="Гайд по оружию Bloodborne" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BLOODBORNE"
                            android:textColor="#B84F13"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Гайд по оружию"
                            android:textColor="#211812"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Основные виды оружия и советы по выбору."
                            android:textColor="#806F60"
                            android:textSize="12sp"
                            android:maxLines="2"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#9B8775"
                        android:textSize="26sp" />

                </LinearLayout>

                <!-- Каталог игр -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Каталог игр"
                        android:textColor="#211812"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="serif" />

                    <TextView
                        android:id="@+id/allGamesButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Все  →"
                        android:textColor="#B84F13"
                        android:textStyle="bold"
                        android:padding="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="145dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <ImageView
                        android:id="@+id/gameEldenRing"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/elden_ring"
                        android:scaleType="centerCrop"
                        android:contentDescription="Elden Ring" />

                    <ImageView
                        android:id="@+id/gameBloodborne"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:src="@drawable/bloodborne"
                        android:scaleType="centerCrop"
                        android:contentDescription="Bloodborne" />

                    <ImageView
                        android:id="@+id/gameDarkSouls"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:src="@drawable/dark_souls3"
                        android:scaleType="centerCrop"
                        android:contentDescription="Dark Souls" />

                    <ImageView
                        android:id="@+id/gameSekiro"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/sekiro"
                        android:scaleType="centerCrop"
                        android:contentDescription="Sekiro" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Нижняя панель -->
        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#E9CDB2">

            <FrameLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/home"
                    android:scaleType="fitCenter"
                    android:contentDescription="Главная" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#F5B77C"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/search"
                    android:scaleType="fitCenter"
                    android:contentDescription="Поиск" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navNews"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/news"
                    android:scaleType="fitCenter"
                    android:contentDescription="Новости" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navGuides"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/guide"
                    android:scaleType="fitCenter"
                    android:contentDescription="Гайды" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>