<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4DFCA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="←  Назад"
            android:textColor="#B84F13"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="МОЙ ПРОФИЛЬ"
            android:textColor="#E96916"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <ImageView
            android:id="@+id/profileAvatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:src="@drawable/avatar1"
            android:scaleType="centerCrop"
            android:contentDescription="Аватар пользователя" />

        <TextView
            android:id="@+id/usernameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Загрузка..."
            android:textColor="#211812"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="vertical"
            android:background="#FFF5E9"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ЭЛЕКТРОННАЯ ПОЧТА"
                android:textColor="#B84F13"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/emailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Загрузка..."
                android:textColor="#211812"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="#E9CDB2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ДАТА РЕГИСТРАЦИИ"
                android:textColor="#B84F13"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/registrationDateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Загрузка..."
                android:textColor="#211812"
                android:textSize="16sp" />

        </LinearLayout>


        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#B84F13"
            android:text="Выйти из аккаунта"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="BEYOND THE FOG"
            android:textColor="#8C7868"
            android:textSize="13sp"
            android:letterSpacing="0.2" />

    </LinearLayout>

</ScrollView>
