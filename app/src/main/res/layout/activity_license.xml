<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LicenseActivity">

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#F5E1D0">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EMBER"
            android:textColor="#E96916"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Лицензионное соглашение"
            android:textColor="#795A43"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false">

            <TextView
                android:id="@+id/licenseAgreementText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_agreement"
                android:textColor="#49382C"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp"
                android:paddingBottom="16dp"/>

        </ScrollView>

        <Button
            android:id="@+id/closeLicenseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Понятно, вернуться"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F58B35"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>