<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5E1D0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="EMBER"
            android:textColor="#E96916"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="#F4CBAA"
            android:padding="12dp"
            android:text="Выбери свой аватар"
            android:textColor="#795A43"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Выбери изображение, которое будет отображаться в твоём профиле."
            android:textColor="#795A43"
            android:textSize="15sp" />

        <!-- Первый ряд -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="30dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <ImageView
                android:id="@+id/avatar1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="7dp"
                android:padding="4dp"
                android:background="#F4CBAA"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Аватар 1"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar1" />

            <ImageView
                android:id="@+id/avatar2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="7dp"
                android:padding="4dp"
                android:background="#F4CBAA"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Аватар 2"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar2" />

        </LinearLayout>

        <!-- Второй ряд -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <ImageView
                android:id="@+id/avatar3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="7dp"
                android:padding="4dp"
                android:background="#F4CBAA"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Аватар 3"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar3" />

            <ImageView
                android:id="@+id/avatar4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="7dp"
                android:padding="4dp"
                android:background="#F4CBAA"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Аватар 4"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar4" />

        </LinearLayout>

        <!-- Третий ряд -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <ImageView
                android:id="@+id/avatar5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="7dp"
                android:padding="4dp"
                android:background="#F4CBAA"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Аватар 5"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar5" />

            <ImageView
                android:id="@+id/avatar6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="7dp"
                android:padding="4dp"
                android:background="#F4CBAA"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Аватар 6"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar6" />

        </LinearLayout>

        <Button
            android:id="@+id/confirmAvatarButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#F58B35"
            android:text="Подтвердить выбор"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
